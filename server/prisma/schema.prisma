generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

// What the visit is about: the service picked on the first booking screen.
enum BookingReason {
  MONEY_AND_CARDS
  SAVINGS
  LOANS
  FAMILY_PROTECTION
  ID_AND_PASSPORT
}

// Locations from the store locator. The first block mirrors the locator response;
// the last block is booking configuration that the locator does not provide.
model Branch {
  id String @id @default(uuid())

  // --- from the locator response ---
  storeCode            String   @unique // `storeCode`: stable ID from the source data
  slug                 String   @unique
  name                 String
  brand                String // opaque brand code; identifies branch / ATM / business centre
  primaryNumber        String?
  address              String // full address as one string
  country              String   @default("South Africa")
  latitude             Float?
  longitude            Float?
  attributes           String[] // e.g. ["Branch", "SmartID Services"], ["ATM"]
  tradingStatus        String? // "Open", "Temporarily Closed", "Permanently Closed"
  opensAt              String? // "08:30" 24h local time; null when no hours are published
  closesAt             String? // "17:00"; "24:00" means midnight
  localPageUrl         String
  googleDirectionsLink String?

  // --- derived from `address` ---
  province String
  city     String

  // --- booking configuration (not in the locator response) ---
  slotMinutes Int       @default(30)
  closedDays  Int[] // 0 = Sunday ... 6 = Saturday
  isActive    Boolean   @default(true) // true = accepts bookings
  bookings    Booking[]

  @@index([province, city])
}

model Booking {
  id              String        @id @default(uuid())
  reference       String        @unique // e.g. BM-7K3F9Q2X (generated by the booking service)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  startsAt        DateTime      @db.Timestamptz
  endsAt          DateTime      @db.Timestamptz
  fullName        String
  email           String? // optional: no confirmation email is sent without it
  phone           String
  reason          BookingReason
  notes           String?
  smsReminder     Boolean       @default(false) // customer asked for a text reminder (nothing sends one yet)
  needsAssistance Boolean       @default(false) // wheelchair ramp access or other help on arrival
  status          BookingStatus @default(CONFIRMED)
  createdAt       DateTime      @default(now())
  cancelledAt     DateTime?

  @@index([branchId, startsAt])
  @@index([email])
}
